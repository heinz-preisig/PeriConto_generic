# Stage 1: Build environment
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
# Update and install dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    libgl1-mesa-glx \
    libgl1 \
    libegl1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
    
# Create and activate virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install PyQt6 in the virtual environment with additional packages
RUN pip3 install --no-cache-dir PyQt6
COPY requirements.txt .
RUN pip install -r requirements.txt

# Stage 2: Runtime environment
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# Copy the virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv
# Set environment variables for virtual environment
ENV PATH="/opt/venv/bin:$PATH"

# Install essential libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libegl1 \
    libgles2 \
    libglvnd0 \
    libxext6 \
    libx11-6 \
    libxkbcommon-x11-0 \
    libsm6 \
    libice6 \
    libxcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-shm0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libx11-xcb1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libxkbcommon0 \
    ibus \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create needed symlink for libEGL.so.1 if it doesn't exist
RUN ldconfig && \
    mkdir -p /usr/lib/x86_64-linux-gnu/ && \
    if [ ! -e /usr/lib/x86_64-linux-gnu/libEGL.so.1 ]; then \
        find /usr -name "libEGL.so*" | head -1 | xargs -I{} ln -sf {} /usr/lib/x86_64-linux-gnu/libEGL.so.1; \
    fi && \
    ls -la /usr/lib/x86_64-linux-gnu/libEGL* || echo "No libEGL files found"

# Set the environment variable to help find the EGL library
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

# Set Qt plugin path and other environment variables
ENV QT_QPA_PLATFORM_PLUGIN_PATH=/opt/venv/lib/python3.10/site-packages/PyQt6/Qt6/plugins
ENV QT_DEBUG_PLUGINS=1
ENV QT_XCB_GL_INTEGRATION=none
ENV QT_QPA_PLATFORM=xcb
ENV QT_IM_MODULE=ibus
ENV XMODIFIERS=@im=ibus
ENV GTK_IM_MODULE=ibus

RUN mkdir -p "Ontology_Repository"
WORKDIR /PeriConto
COPY ./src/ src/
## Set the DISPLAY environment variable
ENV DISPLAY=:0
ENV XDG_RUNTIME_DIR="/PeriConto/src/"
RUN chmod 0700 /PeriConto/src

WORKDIR /PeriConto/src 
CMD ["python3", "-v", "graphviz_test.py"]
